# 1Password-backed environment file.
#
# This file is SAFE TO COMMIT — values are secret references (`op://...`),
# not plaintext. Resolution happens in-memory at process start via:
#
#   op run --env-file=.env.1password -- pnpm dev
#
# Or use the wrapper scripts: `pnpm dev:op`, `pnpm build:op`.
#
# Prerequisites:
#   - 1Password CLI (`brew install 1password-cli`)
#   - Signed in (`op signin`) or desktop-app biometric integration enabled
#   - Items exist in the vault referenced below
#
# Reference format: op://<vault>/<item>/[section/]<field>
# See: content/reference/1password-secrets.md

# --- Public / non-secret ---
NUXT_PUBLIC_SITE_URL=http://localhost:3000
FATHOM_SITE_ID=WMNAGESK

# --- Session / Auth ---
NUXT_SESSION_PASSWORD=op://Kickstart Local/kickstart-session/password
BETTER_AUTH_SECRET=op://Kickstart Local/kickstart-better-auth/password
BETTER_AUTH_URL=http://localhost:3000

# --- OAuth providers ---
NUXT_OAUTH_GITHUB_CLIENT_ID=op://Kickstart Local/kickstart-github-oauth/username
NUXT_OAUTH_GITHUB_CLIENT_SECRET=op://Kickstart Local/kickstart-github-oauth/credential

# --- Google Maps ---
NUXT_PUBLIC_GOOGLE_MAPS_KEY=op://Kickstart Local/kickstart-google-maps/credential

# --- Turso database ---
TURSO_DATABASE_URL=op://Kickstart Local/kickstart-turso/url
TURSO_AUTH_TOKEN=op://Kickstart Local/kickstart-turso/credential

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=op://Kickstart Local/kickstart-twilio/username
TWILIO_AUTH_TOKEN=op://Kickstart Local/kickstart-twilio/credential
TWILIO_PHONE_NUMBER=op://Kickstart Local/kickstart-twilio/phone

# --- Resend email ---
RESEND_API_KEY=op://Kickstart Local/kickstart-resend/credential
EMAIL_FROM_ADDRESS=Kickstart <noreply@yourdomain.com>
NUXT_RESEND_API_KEY=op://Kickstart Local/kickstart-resend/credential
NUXT_EMAIL_FROM=Kickstart <noreply@yourdomain.com>

# --- Admin allowlist ---
ADMIN_EMAILS=admin@example.com

# --- OG Image signing ---
NUXT_OG_IMAGE_SECRET=op://Kickstart Local/kickstart-og-image/password
