{
  "name": "@victortolbert/nuxt-kickstart",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "author": {
    "name": "Victor Tolbert",
    "email": "victor@tolbert.design",
    "url": "https://tolbert.design"
  },
  "scripts": {
    "up": "taze major -I",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "dev": "nuxt dev --no-fork",
    "dev:op": "op run --env-file=.env.1password -- nuxt dev --no-fork",
    "build:op": "op run --env-file=.env.1password -- NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && pnpm run db:init",
    "prepare": "skilld update -b && simple-git-hooks",
    "clean": "rm -rf .nuxt .output dist .cache .data/content",
    "clean:content": "rm -rf .data/content",
    "clean:full": "rm -rf .nuxt .output dist .cache .data node_modules pnpm-lock.yaml && pnpm install",
    "fresh": "pnpm run clean && pnpm run dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "NODE_OPTIONS='--disable-warning=DEP0205' vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:unit": "NODE_OPTIONS='--disable-warning=DEP0205' vitest --project unit",
    "test:nuxt": "NODE_OPTIONS='--disable-warning=DEP0205' vitest --project nuxt",
    "test:watch": "NODE_OPTIONS='--disable-warning=DEP0205' vitest --project unit",
    "test:coverage": "NODE_OPTIONS='--disable-warning=DEP0205' vitest run --coverage",
    "typecheck": "nuxt typecheck",
    "changelog": "changelogithub --dry",
    "init": "pnpm exec tsx scripts/init.ts",
    "db:init": "pnpm exec tsx scripts/init-better-auth-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@fawmi/vue-google-maps": "^0.9.79",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/barlow-semi-condensed": "^5.2.7",
    "@fontsource/lobster": "^5.2.8",
    "@fontsource/lobster-two": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@fullcalendar/vue3": "^6.1.20",
    "@googlemaps/markerclusterer": "2.6.2",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@internationalized/date": "^3.12.2",
    "@libsql/client": "^0.17.3",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/content": "^3.14.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.8.2",
    "@nuxtjs/i18n": "^10.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tiptap/core": "^3.26.1",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "better-auth": "^1.6.18",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "jszip": "^3.10.1",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "nuxt": "^4.4.8",
    "nuxt-authorization": "^0.3.5",
    "nuxt-og-image": "^6.6.0",
    "nuxt-vitalizer": "^2.0.0",
    "openai": "^6.42.0",
    "resend": "^6.12.4",
    "satori": "^0.26.0",
    "shiki": "^4.2.0",
    "slot-text": "^0.2.2",
    "twilio": "^6.0.2",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "vue3-emoji-picker": "^1.1.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.2.1",
    "@eslint/eslintrc": "^3.3.5",
    "@figma-plugin/helpers": "^0.15.2",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.128.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.112",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.86",
    "@iconify-json/tabler": "^1.2.35",
    "@maizzle/framework": "^6.0.0",
    "@maizzle/nuxt": "^1.0.0",
    "@maizzle/tailwindcss": "^1.5.5",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/seo": "^5.3.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tiptap/extension-bubble-menu": "^3.26.1",
    "@tiptap/extension-collaboration": "3.26.1",
    "@tiptap/extension-drag-handle": "^3.26.1",
    "@tiptap/extension-floating-menu": "^3.26.1",
    "@tiptap/extension-list": "^3.26.1",
    "@tiptap/extension-node-range": "^3.26.1",
    "@tiptap/extensions": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "@tiptap/vue-3": "^3.26.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "@victortolbert/preflight": "^0.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "changelogithub": "^14.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-case-police": "^2.2.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "eslint-vitest-rule-tester": "^3.1.0",
    "happy-dom": "^20.10.3",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.2.0",
    "markdownlint": "^0.41.0",
    "markdownlint-cli": "^0.48.0",
    "nano-staged": "^1.0.2",
    "nuxt-fathom": "^0.0.3",
    "nuxt-mcp-dev": "0.3.2",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.1",
    "simple-git-hooks": "^2.13.1",
    "skilld": "^2.0.0",
    "skills-npm": "^1.1.1",
    "style-dictionary": "^5.4.4",
    "tailwindcss": "^4.3.1",
    "taze": "^19.14.1",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vitest-environment-nuxt": "^2.0.0",
    "vue-tsc": "^3.3.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,jsx,tsx,vue}": "eslint --fix"
  }
}
