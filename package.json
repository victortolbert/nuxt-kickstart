{
  "name": "@victortolbert/nuxt-kickstart",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "description": "An opinionated, content-first enterprise starter on Nuxt 4 + Nuxt Content v3 — passwordless auth, admin suite, email, theming, design tokens, i18n.",
  "author": {
    "name": "Victor Tolbert",
    "email": "victor@tolbert.design",
    "url": "https://tolbert.design"
  },
  "license": "MIT",
  "homepage": "https://github.com/victortolbert/nuxt-kickstart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victortolbert/nuxt-kickstart.git"
  },
  "bugs": {
    "url": "https://github.com/victortolbert/nuxt-kickstart/issues"
  },
  "scripts": {
    "up": "taze major -I",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "dev": "nuxt dev --no-fork",
    "dev:op": "op run --env-file=.env.1password -- nuxt dev --no-fork",
    "build:op": "op run --env-file=.env.1password -- NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && pnpm run db:init",
    "prepare": "skilld update -b && simple-git-hooks",
    "clean": "rm -rf .nuxt .output dist .cache .data/content",
    "clean:content": "rm -rf .data/content",
    "clean:full": "rm -rf .nuxt .output dist .cache .data node_modules pnpm-lock.yaml && pnpm install",
    "fresh": "pnpm run clean && pnpm run dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "NODE_OPTIONS='--disable-warning=DEP0205' vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:unit": "NODE_OPTIONS='--disable-warning=DEP0205' vitest --project unit",
    "test:nuxt": "NODE_OPTIONS='--disable-warning=DEP0205' vitest --project nuxt",
    "test:watch": "NODE_OPTIONS='--disable-warning=DEP0205' vitest --project unit",
    "test:coverage": "NODE_OPTIONS='--disable-warning=DEP0205' vitest run --coverage",
    "typecheck": "nuxt typecheck",
    "changelog": "changelogithub --dry",
    "init": "pnpm exec tsx scripts/init.ts",
    "db:init": "pnpm exec tsx scripts/init-better-auth-db.ts",
    "lint:md": "markdownlint .",
    "lint:md:fix": "markdownlint --fix ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/lobster-two": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@libsql/client": "^0.17.4",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/content": "^3.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "better-auth": "^1.6.29",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "nuxt": "^4.5.2",
    "nuxt-authorization": "^0.3.5",
    "nuxt-og-image": "^6.7.8",
    "nuxt-vitalizer": "^3.0.0",
    "resend": "^6.20.0",
    "satori": "^0.29.0",
    "shiki": "^4.4.3",
    "twilio": "^6.1.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@eslint/eslintrc": "^3.3.6",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/tabler": "^1.2.38",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/seo": "^5.3.12",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.4",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.2.0",
    "@victortolbert/preflight": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "changelogithub": "^15.0.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-case-police": "^2.2.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "eslint-vitest-rule-tester": "^3.1.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "markdownlint": "^0.41.1",
    "markdownlint-cli": "^0.49.1",
    "nano-staged": "^1.0.2",
    "nuxt-fathom": "^0.0.3",
    "nuxt-mcp-dev": "0.3.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "simple-git-hooks": "^2.13.1",
    "skilld": "^2.3.0",
    "skills-npm": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "taze": "^21.1.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-environment-nuxt": "^2.0.0",
    "vue-tsc": "^3.3.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,jsx,tsx,vue}": "eslint --fix"
  }
}
