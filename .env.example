# Site URL - used for image base URLs and absolute paths
# Set to your local dev server URL during development
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps JavaScript API key
# Optional: /examples/maps renders blank without it, nothing else is affected
# Create at: https://console.cloud.google.com/google/maps-apis/credentials
NUXT_PUBLIC_GOOGLE_MAPS_KEY=

# Content Repository Configuration
# External repository for content (optional)
# Format: https://github.com/{owner}/{repo}
# (e.g., https://github.com/victortolbert/kickstart-content)
NUXT_CONTENT_REPO_URL=

# GitHub Personal Access Token for private content repositories
# Create at: https://github.com/settings/tokens
# Required scopes: repo (for private repos)
NUXT_CONTENT_AUTH_TOKEN=

# Branch to fetch content from (default: main)
NUXT_CONTENT_BRANCH=main

# Collections to keep local (comma-separated)
# Example: notes,logs (these won't be fetched from external repo)
# Note: Use NUXT_PUBLIC_CONTENT_LOCAL_COLLECTIONS if you need client-side access (e.g., for edit links)
NUXT_CONTENT_LOCAL_COLLECTIONS=
NUXT_PUBLIC_CONTENT_LOCAL_COLLECTIONS=

# Require external content repository (fail if not configured)
# Set to true in production to ensure external content is available
NUXT_CONTENT_REQUIRE_EXTERNAL=false

# GitHub OAuth (used by Better Auth)
# Create at: https://github.com/settings/developers
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# Dev:     http://localhost:3000/api/auth/callback/github
# Netlify: https://nuxt-kickstart.example.com/api/auth/callback/github
# Prod:    https://nuxt-kickstart.example.com/api/auth/callback/github
# NOTE: You may need separate GitHub OAuth apps for each environment
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Resend (for magic link emails and general email sending)
# Create at: https://resend.com/api-keys
RESEND_API_KEY=
# Default uses Resend's zero-setup test sender (onboarding@resend.dev): works with any
# valid key but only DELIVERS to your Resend-account email. For production, verify a
# domain in Resend and swap this to e.g. Kickstart <noreply@yourdomain.com>.
EMAIL_FROM_ADDRESS=Kickstart <onboarding@resend.dev>

# Database (Turso / libSQL)
# Leave unset for local SQLite (stored at .data/auth.db) - recommended for development
# The app will automatically fall back to local SQLite if Turso connection fails (e.g., corporate proxy)
# For Turso remote: turso db show <db-name> --url / turso db tokens create <db-name>
# Example Turso URL: libsql://your-db-name.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Better Auth
# Secret: minimum 32 characters. Generate with: openssl rand -base64 32
# URL: your app's base URL (used for OAuth callbacks, CSRF origin checks, and redirects)
# CRITICAL: Must match the domain users access the app from, otherwise social sign-in returns 403
# Dev:     http://localhost:3000
# Netlify: https://nuxt-kickstart.example.com
# Prod:    https://nuxt-kickstart.example.com
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admin Email Allowlist
# Comma-separated list of admin emails (auto-assigned admin role on sign-up)
# Example: victor@example.com,admin@example.com
ADMIN_EMAILS=

# Twilio SMS OTP
# Create at: https://console.twilio.com
# Account SID & Auth Token: found on main dashboard under "Account Info"
# Phone Number: Phone Numbers → Manage → Active Numbers (must have SMS capability)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Scoreboard Real-Time Transport
# Transport mode: 'auto' (default) auto-negotiates best available, or force 'websocket', 'sse', 'polling'
NUXT_PUBLIC_SCOREBOARD_TRANSPORT=auto
# Client-side polling interval in ms (used when transport is 'polling' or as fallback)
NUXT_PUBLIC_SCOREBOARD_POLL_INTERVAL=5000
# SSE endpoint internal DB polling interval in ms (serverless fallback when event bus doesn't persist across invocations)
NUXT_PUBLIC_SCOREBOARD_SSE_POLL_INTERVAL=2000

# ──────────────────────────────────────────────────────────────────────────────
# File Upload / Storage Configuration
# ──────────────────────────────────────────────────────────────────────────────

# Storage Provider - determines where uploaded files are stored
# Options: 'local' (filesystem) | 's3' (AWS S3) | 'cloudinary' (Cloudinary CDN)
# Development: use 'local'
# Production (Vercel/Netlify): use 's3' or 'cloudinary'
NUXT_STORAGE_PROVIDER=local

# ──────────────────────────────────────────────────────────────────────────────
# Local Storage (Development Only)
# ──────────────────────────────────────────────────────────────────────────────
# Directory path relative to project root (default: public/img)
# Files are written to this directory and served as static assets
# ⚠️  WARNING: This will NOT work on Vercel/Netlify (ephemeral filesystem)
NUXT_LOCAL_STORAGE_DIR=public/img

# ──────────────────────────────────────────────────────────────────────────────
# AWS S3 Configuration (Production - Recommended for Vercel/Netlify)
# ──────────────────────────────────────────────────────────────────────────────
# Create bucket: https://s3.console.aws.amazon.com/s3/
# IAM credentials: https://console.aws.amazon.com/iam/
# Required IAM policy: s3:PutObject, s3:DeleteObject, s3:HeadObject on your bucket
NUXT_S3_BUCKET=
NUXT_S3_REGION=us-east-1
NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=
# Optional: Custom public URL (e.g., CloudFront CDN)
# If not set, uses default S3 URL: https://BUCKET.s3.REGION.amazonaws.com
NUXT_S3_PUBLIC_URL=

# ──────────────────────────────────────────────────────────────────────────────
# Cloudinary Configuration (Production - Alternative to S3)
# ──────────────────────────────────────────────────────────────────────────────
# Create account: https://cloudinary.com
# Dashboard: https://cloudinary.com/console
# Includes built-in image transformations and CDN
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=


# --- LLM Visibility Optimizer: AI insight provider (server-side only) ---
# Provider: 'anthropic' (direct, outside the enterprise) or 'proxy' (an enterprise
# LiteLLM pass-through, inside the enterprise — Anthropic Messages API compatible).
NUXT_LLM_PROVIDER=anthropic
NUXT_LLM_MODEL=claude-sonnet-4-6
# Required when NUXT_LLM_PROVIDER=anthropic
NUXT_ANTHROPIC_API_KEY=
# Required when NUXT_LLM_PROVIDER=proxy
NUXT_LLM_PROXY_BASE_URL=
NUXT_LLM_PROXY_API_KEY=
# Inside the enterprise, the Anthropic SDK's TLS may need the corporate CA:
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.pem

# --- LLM Visibility Optimizer: Brand Mention multi-provider coverage (server-only) ---
# All OPTIONAL — the Brand Mention test skips any provider whose key is blank.
# The Claude row reuses the provider config above (anthropic or proxy).
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_MODEL=gpt-4o-mini
NUXT_GOOGLE_API_KEY=
NUXT_GOOGLE_MODEL=gemini-flash-latest
NUXT_XAI_API_KEY=
NUXT_XAI_MODEL=grok-2-latest

# --- LLM Visibility Optimizer: headless-render JS detection (Playwright, server-only) ---
# Real SSR/CSR + LCP detection. Falls back to a static heuristic when off or when
# chromium is unavailable (serverless/CI). Default on.
NUXT_LLM_RENDER_ENABLED=true
NUXT_LLM_RENDER_TIMEOUT_MS=15000
